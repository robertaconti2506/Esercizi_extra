# Immagine base Red Hat con Python 3.12: gira gia' con utente non-root (UID 1001)
# ed e' compatibile con l'UID casuale che OpenShift assegna ai container.
FROM registry.access.redhat.com/ubi9/python-312

# La cartella di lavoro predefinita dell'immagine e' /opt/app-root/src

# Prima installiamo le librerie: se il codice cambia ma requirements.txt no,
# questo passaggio viene preso dalla cache e la build e' piu' veloce.
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Poi copiamo il codice dell'app e le migrazioni del database
COPY alembic.ini .
COPY migrations/ migrations/
COPY app/ app/

# Porta su cui ascolta l'app
EXPOSE 8080

# All'avvio: prima aggiorna le tabelle del database, poi avvia l'app.
# --proxy-headers: l'HTTPS termina sul router di OpenShift, che inoltra all'app in http
# e aggiunge l'header X-Forwarded-Proto: https. Con questa opzione l'app lo legge e sa
# che l'utente sta navigando in https.
CMD ["sh", "-c", "alembic upgrade head && exec uvicorn app.main:app --host 0.0.0.0 --port 8080 --proxy-headers --forwarded-allow-ips='*'"]
