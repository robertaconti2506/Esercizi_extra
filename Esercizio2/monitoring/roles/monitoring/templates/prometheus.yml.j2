---
global:
  scrape_interval: "{{ monitoring_prometheus_scrape_interval }}"

scrape_configs:
  - job_name: "node-exporter"
    static_configs:
      - targets:
{% for host in groups['monitoring'] %}
          - "{{ hostvars[host]['ansible_host'] }}:{{ monitoring_node_exporter_ports.get(host) }}"
{% endfor %}
