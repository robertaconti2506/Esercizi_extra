[all:vars]
ansible_user=vagrant
ansible_ssh_common_args='-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null'

[elasticsearch]
elasticsearch-host ansible_host=192.168.45.13 ansible_ssh_private_key_file=vagrant/.vagrant/machines/elasticsearch-host/virtualbox/private_key

[grafana]
monitoring-grafana ansible_host=192.168.45.14 ansible_ssh_private_key_file=vagrant/.vagrant/machines/monitoring-grafana/virtualbox/private_key

[prometheus]
monitoring-prometheus ansible_host=192.168.45.15 ansible_ssh_private_key_file=vagrant/.vagrant/machines/monitoring-prometheus/virtualbox/private_key

[monitoring:children]
elasticsearch
grafana
prometheus
